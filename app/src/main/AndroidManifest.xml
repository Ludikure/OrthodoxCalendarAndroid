<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Slava reminders (Serbian only): posting them, and re-arming their alarms
         after a reboot, which clears every alarm an app has set. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      largeHeap is kept deliberately. It was introduced while two CalendarRepository
      instances each held the 17 MB texts_ru.json pool; that duplication is fixed, but
      one decoded pool is still tens of MB resident and minSdk is 26, where a device
      can hand the process a 96 MB heap. Dropping it needs a measurement on real
      low-end hardware (Debug > Memory Profiler, RU locale, a downloaded year), not a
      guess — the failure mode is an OOM crash on exactly the devices we cannot test on.
    -->
    <application
        android:name=".OrthodoxCalendarApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OrthodoxCalendar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OrthodoxCalendar.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".app.SlavaReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".app.SlavaRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets (widget/TodayWidget.kt): one widget offered at
             two sizes in the picker. -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_small" />
        </receiver>
        <receiver
            android:name=".widget.TodayWideWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_wide" />
        </receiver>
        <!-- Turns the widgets' page at midnight (an inexact alarm) and redraws
             them when the clock or time zone changes. -->
        <receiver
            android:name=".widget.WidgetMidnightReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
