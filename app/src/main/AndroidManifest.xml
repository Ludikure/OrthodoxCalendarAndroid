<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      largeHeap is kept deliberately. It was introduced while two CalendarRepository
      instances each held the 17 MB texts_ru.json pool; that duplication is fixed, but
      one decoded pool is still tens of MB resident and minSdk is 26, where a device
      can hand the process a 96 MB heap. Dropping it needs a measurement on real
      low-end hardware (Debug > Memory Profiler, RU locale, a downloaded year), not a
      guess — the failure mode is an OOM crash on exactly the devices we cannot test on.
    -->
    <application
        android:name=".OrthodoxCalendarApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OrthodoxCalendar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OrthodoxCalendar.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
