<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ variant of backup_rules.xml: downloaded years are re-fetchable. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="calendar_cache" />
        <exclude domain="file" path="widget_snapshot.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="calendar_cache" />
        <exclude domain="file" path="widget_snapshot.json" />
    </device-transfer>
</data-extraction-rules>
