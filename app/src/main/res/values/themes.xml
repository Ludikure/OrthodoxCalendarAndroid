<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OrthodoxCalendar" parent="android:Theme.Material.Light.NoActionBar">
        <!-- The colour Compose paints over, so the window never shows framework
             white. See values-night/themes.xml for the dark variant. -->
        <item name="android:windowBackground">@color/window_background</item>
    </style>
    <style name="Theme.OrthodoxCalendar.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF2C2418</item>
        <item name="postSplashScreenTheme">@style/Theme.OrthodoxCalendar</item>
    </style>
</resources>
