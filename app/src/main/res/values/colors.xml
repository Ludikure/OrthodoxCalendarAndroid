<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The window background: what the window shows before Compose paints, and
      what shows through for the moment under the splash. The values mirror
      AppColors.warmBg in ui/theme/AppColors.kt (light #F5F3EE, dark #1C1A17) —
      a Compose constant and an XML colour cannot share a definition, so if that
      one changes these change with it.

      Without the night variant the window was white under a dark app theme: a
      white flash beneath the splash and a light launch preview in Recents.
    -->
    <color name="window_background">#FFF5F3EE</color>

    <!-- The widget picker's preview (layout/widget_preview_*.xml), which is
         drawn from resources before the widget has ever run. Same values as
         WidgetColors in widget/TodayWidget.kt. -->
    <color name="widget_bg">#FFF5F3EE</color>
    <color name="widget_crimson">#FFC94040</color>
    <color name="widget_muted">#FF8C7E6A</color>
    <color name="widget_dark_text">#FF2C2418</color>
    <color name="widget_gold_accent">#FFD4C5A9</color>
    <color name="widget_slava_gold">#FF8A6A12</color>
    <color name="widget_fish">#FF2D6B4F</color>
    <color name="widget_fish_bg">#FFE8F5EC</color>
</resources>
